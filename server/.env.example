# Copy this file to .env and fill in real values. NEVER commit .env itself.

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000"

# Cookie
COOKIE_SECRET="replace-with-another-long-random-string"

# bcrypt
BCRYPT_SALT_ROUNDS=12
